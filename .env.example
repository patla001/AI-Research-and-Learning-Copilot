# Local development overrides. Copy to .env and fill in.
# On Databricks Apps these come from app.yaml (secret resources + env block).
# Do NOT commit a filled-in .env - the Lakebase URL contains the role password.

# --- Required -------------------------------------------------------------
LAKEBASE_URL=postgresql://<role>:<password>@<host>:5432/databricks_postgres?sslmode=require

# --- OpenAlex ---------------------------------------------------------------
# Free key from https://openalex.org/settings/api. Without one the API still
# works at 1,000 credits/day (a search costs 10); with one you get 100,000.
# Full-text content downloads (100 credits each) REQUIRE a key.
# OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@example.edu

# --- Claude agent -----------------------------------------------------------
# Without a key, everything except POST /copilot/chat still works.
# ANTHROPIC_API_KEY=sk-ant-...
# COPILOT_MODEL=claude-opus-5
# COPILOT_EFFORT=medium
# COPILOT_DAILY_LIMIT=200

# --- Identity ---------------------------------------------------------------
# Databricks Apps forwards the signed-in user's email. Locally there is no
# proxy, so requests are attributed to this user.
# COPILOT_DEFAULT_USER=student@example.edu

# --- Optional ---------------------------------------------------------------
# LAKEBASE_SECRET_SCOPE=database
# LAKEBASE_SECRET_KEY=copilot-lakebase-url
# COPILOT_EMBED_MODEL=BAAI/bge-small-en-v1.5
# COPILOT_DB_DRIVER=psycopg2
# FASTEMBED_CACHE_PATH=/tmp/.cache/fastembed
# FLASK_RUN_PORT=8000
# FLASK_DEBUG=1
